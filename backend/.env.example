# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env.

# Database (MySQL) - required: the backend will not start without these.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_hunting_ai
DB_USER=your_database_user
DB_PASSWORD=your_database_password
# Optional: path to the server's CA certificate. Required for Aiven (download ca.pem
# from the Aiven console). Leave blank for a local database without SSL.
DB_SSL_CA=

# Test database - optional. Only for the database integration tests, which are
# skipped if these are blank. Must be a separate database: the tests add and delete rows.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_NAME=
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_SSL_CA=

# Adzuna API - not used by the backend yet.
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here
